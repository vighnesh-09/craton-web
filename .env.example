# Copy to .env.local for local overrides (never commit secrets)
# Only VITE_* keys are exposed to the browser — keep secrets server-side.

VITE_APP_NAME=Craton Technologies
VITE_APP_URL=http://localhost:3000
VITE_CONTACT_EMAIL=hello@craton.io
VITE_PORT=3000
VITE_PREVIEW_PORT=4173

# Formspree / Netlify Forms / webhook URL (POST JSON or form-urlencoded)
VITE_FORM_ENDPOINT=

# Calendly / Cal.com booking link for pilots
VITE_BOOKING_URL=

# Optional hero media (lazy). Example: /hero/reel.webm
VITE_HERO_VIDEO_URL=
VITE_HERO_POSTER_URL=
