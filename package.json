{
  "name": "craton-web",
  "private": true,
  "version": "1.0.0",
  "description": "Craton Technologies marketing site",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
